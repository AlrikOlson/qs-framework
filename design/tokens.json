{
  "$comment": [
    "Visual settings shared by the UI components.",
    "Light and dark themes have separate values.",
    "contrast_pairs lists foreground and background combinations to check."
  ],
  "version": 2,
  "$ramp_comment": [
    "Colors are stored in OKLCH and resolved to sRGB when loaded.",
    "Each ramp sets a hue. Lightness l is in thousandths: 974 means 0.974.",
    "Omitted chroma uses the ramp curve: chroma * (4*l*(1-l))^1.5.",
    "c sets absolute chroma; s sets a fraction of the maximum in-gamut chroma."
  ],
  "ramps": {
    "neutral": {
      "hue": 268,
      "chroma": 0.024
    },
    "accent": {
      "hue": 260
    },
    "amber": {
      "hue": 73
    },
    "green": {
      "hue": 149
    },
    "red": {
      "hue": 27
    }
  },
  "$type_comment": [
    "Text roles specify a logical size and an OpenType weight class.",
    "Device scale and the OS text-size setting are applied when text is drawn.",
    "The font database selects the available face for each weight."
  ],
  "type": {
    "ui/xs": {
      "size": 11,
      "weight": 500,
      "description": "Badges, column headers."
    },
    "ui/sm": {
      "size": 12,
      "weight": 400,
      "description": "Secondary metadata: size, modified, kind."
    },
    "ui/md": {
      "size": 13,
      "weight": 400,
      "description": "Row names, body."
    },
    "ui/lg": {
      "size": 15,
      "weight": 600,
      "description": "Section headers, breadcrumb current."
    },
    "ui/xl": {
      "size": 20,
      "weight": 600,
      "description": "Empty-state headlines."
    }
  },
  "$space_comment": [
    "Spacing and radii are in logical pixels and scale with the display.",
    "Components use the named steps. Column widths are measured from their contents."
  ],
  "space": {
    "xs": 2,
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 12,
    "2xl": 16,
    "3xl": 24,
    "4xl": 32
  },
  "radius": {
    "chip": 3,
    "row": 6,
    "panel": 10,
    "popover": 14
  },
  "$elevation_comment": [
    "Named surface heights above the canvas, in logical pixels.",
    "Canvas elevation is zero. Raised surfaces can cast shadows onto lower ones."
  ],
  "elevation": {
    "canvas": 0,
    "row": 1,
    "raised": 5,
    "overlay": 10,
    "popover": 16
  },
  "$focus_comment": [
    "A two-pixel focus ring with a one-pixel contrasting outline.",
    "The outline keeps the ring visible against surfaces with a similar color."
  ],
  "focus": {
    "ring_width": 2,
    "outline_width": 1
  },
  "$lighting_comment": [
    "allowance limits lighting changes to preserve foreground contrast.",
    "rig configures the lights and reflected environment.",
    "Materials with text use the text-ground limits; other surfaces use receiver limits.",
    "Run the lit_probe example after changing the palette or these limits."
  ],
  "lighting": {
    "allowance": {
      "text_ground": {
        "light": {
          "attenuation_min": 0.87,
          "addition_max": 0.0
        },
        "dark": {
          "attenuation_min": 0.55,
          "addition_max": 0.0
        }
      },
      "receiver": {
        "light": {
          "attenuation_min": 0.0,
          "addition_max": 0.35
        },
        "dark": {
          "attenuation_min": 0.0,
          "addition_max": 0.35
        }
      }
    },
    "$rig_comment": [
      "key.share divides exposure between the key light and environment.",
      "key.direction points toward the light and is normalized when used.",
      "key.size_deg sets angular size, which controls shadow softness.",
      "Environment stops name palette colors, so they follow the theme."
    ],
    "rig": {
      "key": {
        "$comment": [
          "Keep direction equal to qs_gpu::frame::LIGHT_DIR.",
          "Bevel shading, contact shadows and scene lighting use the same direction."
        ],
        "direction": [
          -0.32,
          -0.55,
          0.77
        ],
        "share": 0.72,
        "size_deg": 5.0
      },
      "focus": {
        "$comment": [
          "The focus lamp follows the focused rectangle supplied by layout.",
          "share mixes lamp and key-light attenuation; ambient dims with distance.",
          "The result remains within the theme lighting limits.",
          "Reduced motion places the lamp at focus immediately."
        ],
        "share": 0.45,
        "ambient": 0.18,
        "size_deg": 22.0,
        "height": 14.0
      },
      "environment": {
        "horizon": "surface/base",
        "zenith": "surface/overlay-lift"
      }
    },
    "$allowance_note": [
      "The dark-theme text-ground floor is 0.55.",
      "It preserves contrast across shadowed and emissive states.",
      "Receiver surfaces keep a separate allowance. Check changes with lit_probe."
    ]
  },
  "$substance_comment": [
    "File size changes the bevel near a row edge without changing its center.",
    "span is a base-two exponent: 30 means one GiB reaches at_max.",
    "Size is mapped logarithmically. Equal endpoints disable the variation."
  ],
  "substance": {
    "size": {
      "at_min": 1.0,
      "at_max": 4.0,
      "span": 30
    }
  },
  "$emissive_comment": [
    "Emissive colors are separate from the ordinary palette.",
    "They can exceed the palette-derived bloom threshold.",
    "Only layers with an edge may use them; text and background references are rejected.",
    "Check bloom on rendered frames as well as checking the palette contrast."
  ],
  "emissive": {
    "emissive/sweep-peak": {
      "light": {
        "ramp": "accent",
        "l": 1000,
        "s": 1.0
      },
      "dark": {
        "ramp": "accent",
        "l": 1000,
        "s": 1.0
      },
      "description": "Bright sweep highlight along the command bar edge. It can trigger bloom in the dark theme; the light theme already has a white palette ceiling."
    }
  },
