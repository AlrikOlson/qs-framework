  "$material_comment": [
    "Materials are ordered stacks of effects using palette colors and named scale steps.",
    "over lists possible backgrounds; text lists foregrounds checked against the composite.",
    "GPU-only effects declare simpler CPU fallbacks."
  ],
  "materials": {
    "surface/canvas": {
      "elevation": "canvas",
      "over": [
        "surface/base"
      ],
      "text": [
        "content/primary",
        "content/secondary",
        "content/tertiary"
      ],
      "description": "Window background with four drifting color centers.",
      "layers": [
        {
          "effect": "field",
          "color": "surface/base",
          "amplitude": 0.6,
          "phase": {
            "rotate": 1.0
          },
          "centres": [
            {
              "color": "field/one",
              "at": [
                0.14,
                0.1
              ],
              "drift": [
                0.07,
                0.05
              ],
              "reach": 0.62,
              "phase": 0.0
            },
            {
              "color": "field/two",
              "at": [
                0.88,
                0.2
              ],
              "drift": [
                0.06,
                0.06
              ],
              "reach": 0.56,
              "phase": 0.31
            },
            {
              "color": "field/three",
              "at": [
                0.22,
                0.88
              ],
              "drift": [
                0.05,
                0.07
              ],
              "reach": 0.58,
              "phase": 0.62
            },
            {
              "color": "field/four",
              "at": [
                0.8,
                0.78
              ],
              "drift": [
                0.06,
                0.04
              ],
              "reach": 0.54,
              "phase": 0.85
            }
          ]
        },
        {
          "effect": "sweep",
          "color": "surface/base",
          "to": "surface/row-alt",
          "angle": 270,
          "alpha": 0.55,
          "flat": "surface/base",
          "phase": {
            "rotate": 1.0
          }
        }
      ]
    },
    "row/body": {
      "elevation": "row",
      "over": [
        "surface/base",
        "field/one",
        "field/two",
        "field/three",
        "field/four"
      ],
      "text": [
        "content/primary",
        "content/secondary",
        "content/tertiary"
      ],
      "description": "Translucent row surface over the canvas. File size can vary its bevel.",
      "layers": [
        {
          "effect": "pbr",
          "color": "surface/base",
          "alpha": 0.34,
          "bevel": 2.0,
          "roughness": 0.6,
          "metallic": 0.0,
          "env": 0.4
        }
      ]
    },
    "row/body-alt": {
      "elevation": "row",
      "over": [
        "surface/base",
        "field/one",
        "field/two",
        "field/three",
        "field/four"
      ],
      "text": [
        "content/primary",
        "content/secondary",
        "content/tertiary"
      ],
      "description": "Alternate row surface with a different albedo and the same opacity as row/body.",
      "layers": [
        {
          "effect": "pbr",
          "color": "surface/row-alt",
          "alpha": 0.34,
          "bevel": 2.0,
          "roughness": 0.6,
          "metallic": 0.0,
          "env": 0.4
        }
      ]
    },
    "row/hover": {
      "elevation": "row",
      "over": [
        "surface/base",
        "surface/row-alt",
        "field/one",
        "field/four"
      ],
      "text": [
        "content/primary",
        "content/secondary",
        "content/tertiary"
      ],
      "description": "Pointer-hover wash. Applying it again deepens the pressed state.",
      "layers": [
        {
          "effect": "glow",
          "color": "border/focus",
          "alpha": 0.16,
          "reach": "xl"
        },
        {
          "effect": "fill",
          "color": "surface/row-hover"
        },
        {
          "effect": "rim",
          "color": "content/primary",
          "alpha": 0.1,
          "width": 2
        }
      ]
    },
    "row/selected": {
      "elevation": "raised",
      "over": [
        "surface/base",
        "surface/row-alt",
        "surface/row-hover",
        "field/one",
        "field/four"
      ],
      "text": [
        "content/on-accent"
      ],
      "text_lit": [
        "content/on-lit"
      ],
      "description": "Selected row with a contact shadow, halo and emitting bevel. The CPU renderer uses its flat fill.",
      "layers": [
        {
          "effect": "glow",
          "color": "shadow/contact",
          "alpha": 0.55,
          "reach": "md",
          "offset": 3
        },
        {
          "effect": "glow",
          "color": "border/focus",
          "alpha": 0.42,
          "reach": "lg",
          "swell": {
            "alpha": 1.6,
            "reach": 1.4
          },
          "$comment": [
            "Selection halo behind the row.",
            "Reach is limited to lg to stay within the tested overdraw budget."
          ]
        },
        {
          "effect": "pbr",
          "color": "border/focus",
          "bevel": 3,
          "roughness": 0.22,
          "metallic": 0.0,
          "env": 0.3,
          "emission": 1.15,
          "emits": "border/focus",
          "emits_strength": 1.6,
          "phase": {
            "flicker": 0.06
          },
          "$comment": [
            "The accent-colored surface emits along its bevel.",
            "Contrast checks include peak emission and the lit foreground colors."
          ]
        },
        {
          "effect": "rim",
          "color": "border/focus",
          "alpha": 0.32,
          "width": 2,
          "swell": {
            "alpha": 1.3
          }
        }
      ]
    },
    "chrome/bar": {
      "elevation": "overlay",
      "over": [
        "surface/base"
      ],
      "text": [
        "content/on-overlay",
        "content/on-overlay-dim"
      ],
      "description": "Command-bar gradient with a moving highlight along its bottom edge. The emissive band provides a bloom source.",
      "layers": [
        {
          "effect": "gradient",
          "color": "surface/overlay-lift",
          "to": "surface/overlay",
          "angle": 90,
          "flat": "surface/overlay"
        },
        {
          "effect": "fill",
          "color": "content/on-overlay",
          "alpha": 0.09,
          "edge": "top",
          "thickness": 1
        },
        {
          "effect": "sweep",
          "color": "border/subtle",
          "to": "emissive/sweep-peak",
          "angle": 0,
          "alpha": 1.0,
          "flat": "border/subtle",
          "edge": "bottom",
          "thickness": 8,
          "phase": {
            "rotate": 1.0
          }
        }
      ]
    },
    "chrome/chip-hover": {
      "elevation": "popover",
      "over": [
        "surface/overlay",
        "surface/overlay-lift"
      ],
      "text": [
        "content/on-overlay",
        "content/on-overlay-dim"
      ],
      "description": "Hovered navigation chip with a light fill, rim and outline. The CPU renderer keeps the fill and outline.",
      "layers": [
        {
          "effect": "pbr",
          "color": "surface/overlay-lift",
          "bevel": 3,
          "roughness": 0.22,
          "metallic": 0.15,
          "env": 0.45,
          "radius": "row"
        },
        {
          "effect": "rim",
          "color": "content/on-overlay",
          "alpha": 0.5,
          "width": 1.5,
          "radius": "row"
        },
        {
          "effect": "stroke",
          "color": "content/on-overlay",
          "alpha": 0.2,
          "width": 1,
          "radius": "row"
        }
      ]
    },
    "chrome/shelf": {
      "elevation": "overlay",
      "over": [
        "surface/base"
      ],
      "text": [
        "content/on-overlay"
      ],
      "description": "Status-shelf gradient with a sweep along its top edge.",
      "layers": [
        {
          "effect": "gradient",
          "color": "surface/overlay",
          "to": "surface/overlay-lift",
          "angle": 90,
          "flat": "surface/overlay"
        },
        {
          "effect": "sweep",
          "color": "border/subtle",
          "to": "border/focus",
          "angle": 180,
          "alpha": 0.7,
          "flat": "border/subtle",
          "edge": "top",
          "thickness": 1,
          "phase": {
            "rotate": -1.0
          }
        }
      ]
    },
    "chrome/popover": {
      "elevation": "popover",
      "over": [
        "surface/base",
        "surface/row-alt"
      ],
      "text": [
        "content/primary",
        "content/secondary"
      ],
      "description": "Blurred panel using surface/raised at 0.82 opacity, with an opaque fallback in the same color.",
      "layers": [
        {
          "effect": "backdrop",
          "color": "surface/raised",
          "alpha": 0.9,
          "floor": "surface/raised"
        },
        {
          "effect": "stroke",
          "color": "border/subtle",
          "width": 1
        }
      ]
    }
  },
  "contrast_pairs": [
    {
      "$comment": [
        "Foreground and background combinations checked for contrast.",
        "Decorative separators are excluded; focus and status indicators are included."
      ]
    },
